  "version": "1.0.0",
  "description": "Universal Smart File Organizer - Local-first, privacy-focused, cross-platform file management engine",
  "main": "server/index.js",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "vite",
